# Fine-grained token: read-only "Contents" on the watched repos (only needed for private ones),
# plus read-only "Email addresses" so the signing key gets your primary email.
GITHUB_TOKEN=

# Host port to expose the HTTP server on.
HOST_PORT=8080

# Files in the bind-mounted data folder are created as this user.
UID=1000
GID=1000

# Extra logging, e.g. rehost-gh:* for everything including every command run.
DEBUG=rehost-gh:*,-rehost-gh:exec
